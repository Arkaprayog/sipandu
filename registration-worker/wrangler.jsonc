{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sipandu-registration",
  "main": "index.runtime.js",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "vars": {
    "FIREBASE_PROJECT_ID": "gen-lang-client-0197631978",
    "FIREBASE_DATABASE_ID": "ai-studio-sipanduodhiv-985a0308-7693-46e1-b6d3-fdbce52371a8"
  },
  "kv_namespaces": [
    {
      "binding": "PENDING_REGISTRATIONS",
      "id": "49fbf170f6f6410f9ae787a7cc63ffb9"
    }
  ],
  "secrets": {
    "required": [
      "TEAM_REGISTRATION_CODE",
      "FIREBASE_SERVICE_ACCOUNT_JSON",
      "TURNSTILE_SECRET_KEY",
      "FIREBASE_WEB_API_KEY"
    ]
  }
}
