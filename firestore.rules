rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(roleName) {
      return signedIn() && request.auth.token.role == roleName;
    }

    function isStaff() {
      return hasRole('owner') || hasRole('supervisor') || hasRole('pendamping');
    }

    function canWritePpks() {
      return hasRole('owner') || hasRole('supervisor');
    }

    function isValidStageOnePayload() {
      let d = request.resource.data;
      return d.keys().hasAll([
          'timestamp', 'namaLengkap', 'nik', 'usia', 'jenisKelamin',
          'kotaDomisili', 'alamatLengkap', 'noHpWa', 'jenisBantuan',
          'intervensiMental', 'desil', 'fotoDiri', 'fotoKtp',
          'statusAsesmen', 'source', 'submittedAt'
        ])
        && d.keys().hasOnly([
          'timestamp', 'namaLengkap', 'nik', 'usia', 'jenisKelamin',
          'kotaDomisili', 'alamatLengkap', 'noHpWa', 'jenisBantuan',
          'intervensiMental', 'desil', 'fotoDiri', 'fotoKtp',
          'statusAsesmen', 'source', 'submittedAt'
        ])
        && d.timestamp is string && d.timestamp.size() <= 40
        && d.namaLengkap is string && d.namaLengkap.size() >= 2 && d.namaLengkap.size() <= 120
        && d.nik is string && d.nik.matches('^[0-9]{16}$')
        && d.usia is int && d.usia >= 1 && d.usia <= 100
        && d.jenisKelamin in ['Laki-laki', 'Perempuan']
        && d.kotaDomisili is string && d.kotaDomisili.size() >= 2 && d.kotaDomisili.size() <= 100
        && d.alamatLengkap is string && d.alamatLengkap.size() <= 300
        && d.noHpWa is string && d.noHpWa.size() >= 8 && d.noHpWa.size() <= 25
        && d.jenisBantuan is string && d.jenisBantuan.size() <= 240
        && d.intervensiMental is string && d.intervensiMental.size() <= 1000
        && d.desil is int && d.desil >= 0 && d.desil <= 10
        && d.fotoDiri is string && d.fotoDiri.size() <= 450000
        && d.fotoKtp is string && d.fotoKtp.size() <= 450000
        && d.statusAsesmen == 'Tahap Awal'
        && d.submittedAt == request.time;
    }

    match /ppks/{recordId} {
      allow read: if isStaff();
      allow create, update, delete: if canWritePpks();
    }

    // Public submissions may create only a validated stage-one record.
    // The collection cannot be read by respondents; all read access remains staff-only.
    match /stageOneIntake/{recordId} {
      allow create: if isValidStageOnePayload()
        && (request.resource.data.source == 'respondent-link'
          || (canWritePpks() && request.resource.data.source == 'staff-entry'));
      allow read: if isStaff();
      allow update, delete: if canWritePpks();
    }

    // Deny all collections unless a collection-specific policy is added.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
