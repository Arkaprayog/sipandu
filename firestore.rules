rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(roleName) {
      return signedIn() && request.auth.token.role == roleName;
    }

    function isStaff() {
      return hasRole('owner') || hasRole('supervisor') || hasRole('pendamping');
    }

    function canWritePpks() {
      return hasRole('owner') || hasRole('supervisor');
    }

    // Pendamping may save only the independent integrated-assessment answers.
    // No profile, identity, photo, status, create, or delete permission is granted.
    function canSaveIntegratedAssessment() {
      return hasRole('pendamping')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['formAsesmenTerintegrasi'])
        && request.resource.data.keys().hasAll(['formAsesmenTerintegrasi'])
        && request.resource.data.formAsesmenTerintegrasi is map;
    }

    function isValidStageOnePayload() {
      let d = request.resource.data;
      return d.keys().hasAll([
          'timestamp', 'namaLengkap', 'nik', 'usia', 'jenisKelamin',
          'kotaDomisili', 'alamatLengkap', 'noHpWa', 'jenisBantuan',
          'intervensiMental', 'desil', 'fotoDiri', 'fotoKtp',
          'statusAsesmen', 'source', 'submittedAt'
        ])
        && d.keys().hasOnly([
          'timestamp', 'namaLengkap', 'nik', 'usia', 'jenisKelamin',
          'kotaDomisili', 'alamatLengkap', 'noHpWa', 'jenisBantuan',
          'intervensiMental', 'desil', 'fotoDiri', 'fotoKtp',
          'statusAsesmen', 'source', 'submittedAt'
        ])
        && d.timestamp is string && d.timestamp.size() <= 40
        && d.namaLengkap is string && d.namaLengkap.size() >= 2 && d.namaLengkap.size() <= 120
        && d.nik is string && d.nik.matches('^[0-9]{16}$')
        && d.usia is int && d.usia >= 1 && d.usia <= 100
        && d.jenisKelamin in ['Laki-laki', 'Perempuan']
        && d.kotaDomisili is string && d.kotaDomisili.size() >= 2 && d.kotaDomisili.size() <= 100
        && d.alamatLengkap is string && d.alamatLengkap.size() <= 300
        && d.noHpWa is string && d.noHpWa.size() >= 8 && d.noHpWa.size() <= 25
        && d.jenisBantuan is string && d.jenisBantuan.size() <= 240
        && d.intervensiMental is string && d.intervensiMental.size() <= 1000
        && d.desil is int && d.desil >= 0 && d.desil <= 10
        && d.fotoDiri is string && d.fotoDiri.size() <= 450000
        && d.fotoKtp is string && d.fotoKtp.size() <= 450000
        && d.statusAsesmen == 'Tahap Awal'
        && d.submittedAt == request.time;
    }

    match /ppks/{recordId} {
      allow read: if isStaff();
      allow create, delete: if canWritePpks();
      allow update: if canWritePpks() || canSaveIntegratedAssessment();
    }

    // Public submissions may create only a validated stage-one record.
    // The collection cannot be read by respondents; all read access remains staff-only.
    match /stageOneIntake/{recordId} {
      allow create: if isValidStageOnePayload()
        && (request.resource.data.source == 'respondent-link'
          || (canWritePpks() && request.resource.data.source == 'staff-entry'));
      allow read: if isStaff();
      allow update, delete: if canWritePpks();
    }

    // Shared document archive metadata. Binary files live in Firebase Storage.
    // Drive backup status is stored here so every app/device sees the same state.
    match /staffDocuments/{documentId} {
      allow read: if isStaff();

      allow create: if isStaff()
        && request.resource.data.keys().hasAll([
          'name', 'contentType', 'size', 'storagePath', 'downloadUrl',
          'ownerUid', 'ownerEmail', 'category', 'uploadedAt',
          'driveBackupStatus', 'driveBackupError', 'driveFileId',
          'driveWebViewLink', 'driveBackupAt', 'driveBackupUpdatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'contentType', 'size', 'storagePath', 'downloadUrl',
          'ownerUid', 'ownerEmail', 'category', 'uploadedAt',
          'driveBackupStatus', 'driveBackupError', 'driveFileId',
          'driveWebViewLink', 'driveBackupAt', 'driveBackupUpdatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 255
        && request.resource.data.contentType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'image/jpeg', 'image/png', 'image/gif', 'image/webp',
          'image/bmp', 'image/tiff', 'image/heic', 'image/heif'
        ]
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size <= 25 * 1024 * 1024
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail is string
        && request.resource.data.category in ['surat-tugas', 'surat-lainnya']
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches(
          '^staff-documents/' + request.auth.uid + '/' + documentId + '/[^/]+$'
        )
        && request.resource.data.downloadUrl is string
        && request.resource.data.downloadUrl.size() <= 4096
        && request.resource.data.uploadedAt == request.time
        && request.resource.data.driveBackupStatus == 'pending'
        && request.resource.data.driveBackupError is string
        && request.resource.data.driveBackupError.size() <= 1000
        && request.resource.data.driveFileId == ''
        && request.resource.data.driveWebViewLink == ''
        && request.resource.data.driveBackupAt == null
        && request.resource.data.driveBackupUpdatedAt == request.time;

      // Only backup bookkeeping may change after upload. A staff member can
      // update only their own record; owner/supervisor can maintain any record.
      allow update: if isStaff()
        && (resource.data.ownerUid == request.auth.uid || canWritePpks())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'driveBackupStatus', 'driveBackupError', 'driveFileId',
          'driveWebViewLink', 'driveBackupAt', 'driveBackupUpdatedAt'
        ])
        && request.resource.data.driveBackupStatus in ['pending', 'complete', 'failed']
        && request.resource.data.driveBackupError is string
        && request.resource.data.driveBackupError.size() <= 1000
        && request.resource.data.driveFileId is string
        && request.resource.data.driveFileId.size() <= 256
        && request.resource.data.driveWebViewLink is string
        && request.resource.data.driveWebViewLink.size() <= 4096
        && (request.resource.data.driveBackupAt == null
          || request.resource.data.driveBackupAt is timestamp)
        && request.resource.data.driveBackupUpdatedAt == request.time
        && (request.resource.data.driveBackupStatus != 'complete'
          || (request.resource.data.driveFileId.size() > 0
            && request.resource.data.driveWebViewLink.size() > 0
            && request.resource.data.driveBackupAt is timestamp));

      allow delete: if isStaff()
        && (resource.data.ownerUid == request.auth.uid || canWritePpks());
    }

    // One current Google Drive archive pointer for each independently saved
    // integrated assessment. The full answer map remains in /ppks.
    match /integratedAssessmentBackups/{ppksId} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasAll([
          'ppksId', 'driveBackupStatus', 'driveBackupError',
          'driveFileId', 'driveWebViewLink', 'savedAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ppksId', 'driveBackupStatus', 'driveBackupError',
          'driveFileId', 'driveWebViewLink', 'savedAt', 'updatedAt'
        ])
        && request.resource.data.ppksId == ppksId
        && request.resource.data.driveBackupStatus in ['complete', 'failed']
        && request.resource.data.driveBackupError is string
        && request.resource.data.driveBackupError.size() <= 1000
        && request.resource.data.driveFileId is string
        && request.resource.data.driveFileId.size() <= 256
        && request.resource.data.driveWebViewLink is string
        && request.resource.data.driveWebViewLink.size() <= 4096
        && request.resource.data.savedAt is timestamp
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.driveBackupStatus != 'complete'
          || (request.resource.data.driveFileId.size() > 0
            && request.resource.data.driveWebViewLink.size() > 0));
      allow delete: if canWritePpks();
    }

    // Structured letters created from the Dokumen menu are durable records,
    // not transient React state. Their Drive backup pointer is tracked separately.
    match /staffLetters/{letterId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasAll([
          'id', 'nomorSurat', 'judul', 'jenis', 'tanggal', 'petugas',
          'nipPetugas', 'lokasi', 'status', 'deskripsi',
          'ownerUid', 'ownerEmail', 'createdAt',
          'driveBackupStatus', 'driveBackupError', 'driveFileId',
          'driveWebViewLink', 'driveBackupAt', 'driveBackupUpdatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'nomorSurat', 'judul', 'jenis', 'tanggal', 'petugas',
          'nipPetugas', 'lokasi', 'status', 'deskripsi',
          'ownerUid', 'ownerEmail', 'createdAt',
          'driveBackupStatus', 'driveBackupError', 'driveFileId',
          'driveWebViewLink', 'driveBackupAt', 'driveBackupUpdatedAt'
        ])
        && request.resource.data.id == letterId
        && request.resource.data.nomorSurat is string
        && request.resource.data.nomorSurat.size() > 0
        && request.resource.data.nomorSurat.size() <= 120
        && request.resource.data.judul is string
        && request.resource.data.judul.size() > 0
        && request.resource.data.judul.size() <= 180
        && request.resource.data.jenis in ['Surat Tugas', 'Berita Acara', 'Surat Pernyataan', 'Surat Rujukan', 'Laporan Monev']
        && request.resource.data.tanggal is string
        && request.resource.data.tanggal.size() <= 40
        && request.resource.data.petugas is string
        && request.resource.data.petugas.size() <= 160
        && request.resource.data.nipPetugas is string
        && request.resource.data.nipPetugas.size() <= 40
        && request.resource.data.lokasi is string
        && request.resource.data.lokasi.size() <= 240
        && request.resource.data.status in ['Aktif', 'Selesai', 'Arsip']
        && request.resource.data.deskripsi is string
        && request.resource.data.deskripsi.size() > 0
        && request.resource.data.deskripsi.size() <= 8000
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.driveBackupStatus == 'pending'
        && request.resource.data.driveBackupError is string
        && request.resource.data.driveBackupError.size() <= 1000
        && request.resource.data.driveFileId == ''
        && request.resource.data.driveWebViewLink == ''
        && request.resource.data.driveBackupAt == null
        && request.resource.data.driveBackupUpdatedAt == request.time;
      allow update: if isStaff()
        && (resource.data.ownerUid == request.auth.uid || canWritePpks())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'driveBackupStatus', 'driveBackupError', 'driveFileId',
          'driveWebViewLink', 'driveBackupAt', 'driveBackupUpdatedAt'
        ])
        && request.resource.data.driveBackupStatus in ['pending', 'complete', 'failed']
        && request.resource.data.driveBackupError is string
        && request.resource.data.driveBackupError.size() <= 1000
        && request.resource.data.driveFileId is string
        && request.resource.data.driveFileId.size() <= 256
        && request.resource.data.driveWebViewLink is string
        && request.resource.data.driveWebViewLink.size() <= 4096
        && (request.resource.data.driveBackupAt == null
          || request.resource.data.driveBackupAt is timestamp)
        && request.resource.data.driveBackupUpdatedAt == request.time
        && (request.resource.data.driveBackupStatus != 'complete'
          || (request.resource.data.driveFileId.size() > 0
            && request.resource.data.driveWebViewLink.size() > 0
            && request.resource.data.driveBackupAt is timestamp));
      allow delete: if canWritePpks();
    }

    // Each staff member can read and maintain only their own profile.
    // Role claims are never accepted from client-written profile documents.
    match /userProfiles/{uid} {
      function isOwnProfile() {
        return signedIn() && request.auth.uid == uid;
      }
      function hasValidProfileShape(data) {
        return data.keys().hasAll([
          'nama', 'nip', 'jabatan', 'unitKerja', 'noHp', 'photoUrl', 'email'
        ])
        && data.keys().hasOnly([
          'nama', 'nip', 'jabatan', 'unitKerja', 'noHp', 'photoUrl',
          'email', 'createdAt', 'updatedAt'
        ])
        && data.nama is string && data.nama.size() >= 2 && data.nama.size() <= 120
        && data.nip is string && data.nip.size() <= 40
        && data.jabatan is string && data.jabatan.size() <= 120
        && data.unitKerja is string && data.unitKerja.size() <= 160
        && data.noHp is string && data.noHp.size() <= 30
        && data.photoUrl is string && data.photoUrl.size() <= 400000
        && data.email is string && data.email == request.auth.token.email;
      }
      allow read: if isOwnProfile();
      allow create: if isOwnProfile()
        && hasValidProfileShape(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwnProfile()
        && hasValidProfileShape(request.resource.data)
        // Email is immutable to the user except for repairing its casing or
        // backfilling a missing legacy field; the new value must equal the
        // authenticated Firebase token email (enforced by hasValidProfileShape).
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nama', 'nip', 'jabatan', 'unitKerja', 'noHp', 'photoUrl',
          'email', 'createdAt', 'updatedAt'
        ])
        // Existing creation timestamps are immutable. A missing legacy timestamp
        // may be initialized exactly at request time during the same profile save.
        && (
          ('createdAt' in resource.data
            && request.resource.data.createdAt == resource.data.createdAt)
          || (!('createdAt' in resource.data)
            && request.resource.data.createdAt == request.time)
        )
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Deny all collections unless a collection-specific policy is added.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
