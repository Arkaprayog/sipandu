rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(roleName) {
      return signedIn() && request.auth.token.role == roleName;
    }

    function isStaff() {
      return hasRole('owner') || hasRole('supervisor') || hasRole('pendamping');
    }

    // PPKS records contain sensitive personal and health-related information.
    // Default-deny access until a trusted administrator assigns custom claims.
    match /ppks/{recordId} {
      allow read: if isStaff();
      allow create, update, delete: if hasRole('owner') || hasRole('supervisor');
    }

    // Each authenticated staff member can access only their own profile.
    // This document contains staff identity/contact details, not PPKS records.
    match /staffProfiles/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // Deny all collections unless a collection-specific policy is added.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
