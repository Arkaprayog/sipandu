rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(roleName) {
      return signedIn() && request.auth.token.role == roleName;
    }

    function isStaff() {
      return hasRole('owner') || hasRole('supervisor') || hasRole('pendamping');
    }

    function canWritePpks() {
      return hasRole('owner') || hasRole('supervisor');
    }

    // Pendamping may save only the independent integrated-assessment answers.
    // No profile, identity, photo, status, create, or delete permission is granted.
    function canSaveIntegratedAssessment() {
      return hasRole('pendamping')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['formAsesmenTerintegrasi'])
        && request.resource.data.keys().hasAll(['formAsesmenTerintegrasi'])
        && request.resource.data.formAsesmenTerintegrasi is map;
    }

    function isValidStageOnePayload() {
      let d = request.resource.data;
      return d.keys().hasAll([
          'timestamp', 'namaLengkap', 'nik', 'usia', 'jenisKelamin',
          'kotaDomisili', 'alamatLengkap', 'noHpWa', 'jenisBantuan',
          'intervensiMental', 'desil', 'fotoDiri', 'fotoKtp',
          'statusAsesmen', 'source', 'submittedAt'
        ])
        && d.keys().hasOnly([
          'timestamp', 'namaLengkap', 'nik', 'usia', 'jenisKelamin',
          'kotaDomisili', 'alamatLengkap', 'noHpWa', 'jenisBantuan',
          'intervensiMental', 'desil', 'fotoDiri', 'fotoKtp',
          'statusAsesmen', 'source', 'submittedAt'
        ])
        && d.timestamp is string && d.timestamp.size() <= 40
        && d.namaLengkap is string && d.namaLengkap.size() >= 2 && d.namaLengkap.size() <= 120
        && d.nik is string && d.nik.matches('^[0-9]{16}$')
        && d.usia is int && d.usia >= 1 && d.usia <= 100
        && d.jenisKelamin in ['Laki-laki', 'Perempuan']
        && d.kotaDomisili is string && d.kotaDomisili.size() >= 2 && d.kotaDomisili.size() <= 100
        && d.alamatLengkap is string && d.alamatLengkap.size() <= 300
        && d.noHpWa is string && d.noHpWa.size() >= 8 && d.noHpWa.size() <= 25
        && d.jenisBantuan is string && d.jenisBantuan.size() <= 240
        && d.intervensiMental is string && d.intervensiMental.size() <= 1000
        && d.desil is int && d.desil >= 0 && d.desil <= 10
        && d.fotoDiri is string && d.fotoDiri.size() <= 450000
        && d.fotoKtp is string && d.fotoKtp.size() <= 450000
        && d.statusAsesmen == 'Tahap Awal'
        && d.submittedAt == request.time;
    }

    match /ppks/{recordId} {
      allow read: if isStaff();
      allow create, delete: if canWritePpks();
      allow update: if canWritePpks() || canSaveIntegratedAssessment();
    }

    // Standalone integrated-assessment answers are stored independently from
    // the spreadsheet-owned PPKS profile. This lets pendamping save an answer
    // when the corresponding /ppks roster document has not been synchronized.
    // Only answer maps and audit metadata are accepted; no respondent profile
    // or identity fields can be created or changed through this collection.
    match /integratedAssessmentAnswers/{ppksId} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasAll([
          'ppksId', 'formAsesmenTerintegrasi', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ppksId', 'formAsesmenTerintegrasi', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.ppksId == ppksId
        && request.resource.data.ppksId is string
        && request.resource.data.ppksId.size() > 0
        && request.resource.data.ppksId.size() <= 150
        && request.resource.data.formAsesmenTerintegrasi is map
        && request.resource.data.formAsesmenTerintegrasi.size() <= 96
        && request.resource.data.formAsesmenTerintegrasi.keys().hasOnly(['q1', 'q2', 'q3', 'q4', 'q5', 'q6', 'q7', 'q8', 'q9', 'q10', 'q11', 'q12', 'q13', 'q14', 'q15', 'q16', 'q17', 'q18', 'q19', 'q20', 'q21', 'q22', 'q23', 'q24', 'q25', 'q26', 'q27', 'q28', 'q29', 'q30', 'q31', 'q32', 'q33', 'q34', 'q35', 'q36', 'q37', 'q38', 'q39', 'q40', 'q41', 'q42', 'q43', 'q44', 'q45', 'q46', 'q47', 'q48', 'q49', 'q50', 'q51', 'q52', 'q53', 'q54', 'q55', 'q56', 'q57', 'q58', 'q59', 'q60', 'q61', 'q62', 'q63', 'q64', 'q65', 'q66', 'q67', 'q68', 'q69', 'q70', 'q71', 'q72', 'q73', 'q74', 'q75', 'q76', 'q77', 'q78', 'q79', 'q80', 'q81', 'q82', 'q83', 'q84', 'q85', 'q86', 'q87', 'q88', 'q89', 'q90', 'q91', 'metaSatker', 'metaYear', 'metaSequence', 'kesimpulanResumeKasus', 'rekomendasiCatatanPetugas'])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // Public respondent submissions are accepted only by the Turnstile-verified
    // Registration Worker using a narrowly-scoped server identity. Browser clients
    // may create only staff-entered records after role validation.
    match /stageOneIntake/{recordId} {
      allow create: if canWritePpks()
        && isValidStageOnePayload()
        && request.resource.data.source == 'staff-entry';
      allow read: if isStaff();
      allow update, delete: if canWritePpks();
    }

    // Shared document archive metadata. Binary files live in Firebase Storage.
    // Drive backup status is stored here so every app/device sees the same state.
    match /staffDocuments/{documentId} {
      allow read: if isStaff();

      allow create: if isStaff()
        && request.resource.data.keys().hasAll([
          'name', 'contentType', 'size', 'storagePath', 'downloadUrl',
          'ownerUid', 'ownerEmail', 'category', 'uploadedAt',
          'driveBackupStatus', 'driveBackupError', 'driveFileId',
          'driveWebViewLink', 'driveBackupAt', 'driveBackupUpdatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'contentType', 'size', 'storagePath', 'downloadUrl',
          'ownerUid', 'ownerEmail', 'category', 'uploadedAt',
          'driveBackupStatus', 'driveBackupError', 'driveFileId',
          'driveWebViewLink', 'driveBackupAt', 'driveBackupUpdatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 255
        && request.resource.data.contentType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'image/jpeg', 'image/png', 'image/gif', 'image/webp',
          'image/bmp', 'image/tiff', 'image/heic', 'image/heif'
        ]
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size <= 25 * 1024 * 1024
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail is string
        && request.resource.data.category in ['surat-tugas', 'surat-lainnya']
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches(
          '^staff-documents/' + request.auth.uid + '/' + documentId + '/[^/]+$'
        )
        && request.resource.data.downloadUrl is string
        && request.resource.data.downloadUrl.size() <= 4096
        && request.resource.data.uploadedAt == request.time
        && request.resource.data.driveBackupStatus == 'pending'
        && request.resource.data.driveBackupError is string
        && request.resource.data.driveBackupError.size() <= 1000
        && request.resource.data.driveFileId == ''
        && request.resource.data.driveWebViewLink == ''
        && request.resource.data.driveBackupAt == null
        && request.resource.data.driveBackupUpdatedAt == request.time;

      // Only backup bookkeeping may change after upload. A staff member can
      // update only their own record; owner/supervisor can maintain any record.
      allow update: if isStaff()
        && (resource.data.ownerUid == request.auth.uid || canWritePpks())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'driveBackupStatus', 'driveBackupError', 'driveFileId',
          'driveWebViewLink', 'driveBackupAt', 'driveBackupUpdatedAt'
        ])
        && request.resource.data.driveBackupStatus in ['pending', 'complete', 'failed']
        && request.resource.data.driveBackupError is string
        && request.resource.data.driveBackupError.size() <= 1000
        && request.resource.data.driveFileId is string
        && request.resource.data.driveFileId.size() <= 256
        && request.resource.data.driveWebViewLink is string
        && request.resource.data.driveWebViewLink.size() <= 4096
        && (request.resource.data.driveBackupAt == null
          || request.resource.data.driveBackupAt is timestamp)
        && request.resource.data.driveBackupUpdatedAt == request.time
        && (request.resource.data.driveBackupStatus != 'complete'
          || (request.resource.data.driveFileId.size() > 0
            && request.resource.data.driveWebViewLink.size() > 0
            && request.resource.data.driveBackupAt is timestamp));

      allow delete: if isStaff()
        && (resource.data.ownerUid == request.auth.uid || canWritePpks());
    }

    // One current Google Drive archive pointer for each independently saved
    // integrated assessment. Full answer maps are canonical in
    // /integratedAssessmentAnswers and mirrored to /ppks when that roster row exists.
    match /integratedAssessmentBackups/{ppksId} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasAll([
          'ppksId', 'driveBackupStatus', 'driveBackupError',
          'driveFileId', 'driveWebViewLink', 'savedAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ppksId', 'driveBackupStatus', 'driveBackupError',
          'driveFileId', 'driveWebViewLink', 'savedAt', 'updatedAt'
        ])
        && request.resource.data.ppksId == ppksId
        && request.resource.data.driveBackupStatus in ['complete', 'failed']
        && request.resource.data.driveBackupError is string
        && request.resource.data.driveBackupError.size() <= 1000
        && request.resource.data.driveFileId is string
        && request.resource.data.driveFileId.size() <= 256
        && request.resource.data.driveWebViewLink is string
        && request.resource.data.driveWebViewLink.size() <= 4096
        && request.resource.data.savedAt is timestamp
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.driveBackupStatus != 'complete'
          || (request.resource.data.driveFileId.size() > 0
            && request.resource.data.driveWebViewLink.size() > 0));
      allow delete: if canWritePpks();
    }

    // Structured letters created from the Dokumen menu are durable records,
    // not transient React state. Their Drive backup pointer is tracked separately.
    match /staffLetters/{letterId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasAll([
          'id', 'nomorSurat', 'judul', 'jenis', 'tanggal', 'petugas',
          'nipPetugas', 'lokasi', 'status', 'deskripsi',
          'ownerUid', 'ownerEmail', 'createdAt',
          'driveBackupStatus', 'driveBackupError', 'driveFileId',
          'driveWebViewLink', 'driveBackupAt', 'driveBackupUpdatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'nomorSurat', 'judul', 'jenis', 'tanggal', 'petugas',
          'nipPetugas', 'lokasi', 'status', 'deskripsi',
          'ownerUid', 'ownerEmail', 'createdAt',
          'driveBackupStatus', 'driveBackupError', 'driveFileId',
          'driveWebViewLink', 'driveBackupAt', 'driveBackupUpdatedAt'
        ])
        && request.resource.data.id == letterId
        && request.resource.data.nomorSurat is string
        && request.resource.data.nomorSurat.size() > 0
        && request.resource.data.nomorSurat.size() <= 120
        && request.resource.data.judul is string
        && request.resource.data.judul.size() > 0
        && request.resource.data.judul.size() <= 180
        && request.resource.data.jenis in ['Surat Tugas', 'Berita Acara', 'Surat Pernyataan', 'Surat Rujukan', 'Laporan Monev']
        && request.resource.data.tanggal is string
        && request.resource.data.tanggal.size() <= 40
        && request.resource.data.petugas is string
        && request.resource.data.petugas.size() <= 160
        && request.resource.data.nipPetugas is string
        && request.resource.data.nipPetugas.size() <= 40
        && request.resource.data.lokasi is string
        && request.resource.data.lokasi.size() <= 240
        && request.resource.data.status in ['Aktif', 'Selesai', 'Arsip']
        && request.resource.data.deskripsi is string
        && request.resource.data.deskripsi.size() > 0
        && request.resource.data.deskripsi.size() <= 8000
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.driveBackupStatus == 'pending'
        && request.resource.data.driveBackupError is string
        && request.resource.data.driveBackupError.size() <= 1000
        && request.resource.data.driveFileId == ''
        && request.resource.data.driveWebViewLink == ''
        && request.resource.data.driveBackupAt == null
        && request.resource.data.driveBackupUpdatedAt == request.time;
      allow update: if isStaff()
        && (resource.data.ownerUid == request.auth.uid || canWritePpks())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'driveBackupStatus', 'driveBackupError', 'driveFileId',
          'driveWebViewLink', 'driveBackupAt', 'driveBackupUpdatedAt'
        ])
        && request.resource.data.driveBackupStatus in ['pending', 'complete', 'failed']
        && request.resource.data.driveBackupError is string
        && request.resource.data.driveBackupError.size() <= 1000
        && request.resource.data.driveFileId is string
        && request.resource.data.driveFileId.size() <= 256
        && request.resource.data.driveWebViewLink is string
        && request.resource.data.driveWebViewLink.size() <= 4096
        && (request.resource.data.driveBackupAt == null
          || request.resource.data.driveBackupAt is timestamp)
        && request.resource.data.driveBackupUpdatedAt == request.time
        && (request.resource.data.driveBackupStatus != 'complete'
          || (request.resource.data.driveFileId.size() > 0
            && request.resource.data.driveWebViewLink.size() > 0
            && request.resource.data.driveBackupAt is timestamp));
      allow delete: if canWritePpks();
    }

    // Each staff member can read and maintain only their own profile.
    // Role claims are never accepted from client-written profile documents.
    match /userProfiles/{uid} {
      function isOwnProfile() {
        return signedIn() && request.auth.uid == uid;
      }
      function hasValidProfileShape(data) {
        return data.keys().hasAll([
          'nama', 'nip', 'jabatan', 'unitKerja', 'noHp', 'photoUrl', 'email'
        ])
        && data.nama is string && data.nama.size() >= 2 && data.nama.size() <= 120
        && data.nip is string && data.nip.size() <= 40
        && data.jabatan is string && data.jabatan.size() <= 120
        && data.unitKerja is string && data.unitKerja.size() <= 160
        && data.noHp is string && data.noHp.size() <= 30
        && data.photoUrl is string && data.photoUrl.size() <= 400000
        // The document path is already locked to request.auth.uid. The profile
        // email is private metadata, so authorization must not depend on the
        // optional email claim being present in every Firebase auth provider.
        && data.email is string && data.email.size() > 0 && data.email.size() <= 254;
      }
      allow read: if isOwnProfile();
      allow create: if isOwnProfile()
        && request.resource.data.keys().hasOnly([
          'nama', 'nip', 'jabatan', 'unitKerja', 'noHp', 'photoUrl',
          'email', 'createdAt', 'updatedAt'
        ])
        && hasValidProfileShape(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwnProfile()
        && hasValidProfileShape(request.resource.data)
        // Email is private metadata on this UID-owned profile document.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nama', 'nip', 'jabatan', 'unitKerja', 'noHp', 'photoUrl',
          'email', 'createdAt', 'updatedAt'
        ])
        // Existing creation timestamps are immutable. A missing legacy timestamp
        // may be initialized exactly at request time during the same profile save.
        && (
          ('createdAt' in resource.data
            && resource.data.createdAt != null
            && request.resource.data.createdAt == resource.data.createdAt)
          || ((!('createdAt' in resource.data) || resource.data.createdAt == null)
            && request.resource.data.createdAt == request.time)
        )
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Service-center status is isolated from the spreadsheet-owned PPKS roster.
    function validServiceDate(value) {
      return value is string && value.size() <= 10
        && (value == '' || value.size() == 10);
    }

    function validAssistanceStatus(value) {
      return value in ['belum-diverifikasi', 'dibutuhkan', 'dalam-proses', 'diterima', 'tidak-dibutuhkan'];
    }

    function validTherapyStatus(value) {
      return value in ['belum-dimulai', 'terjadwal', 'aktif', 'selesai'];
    }

    function validFollowUpReason(value) {
      return value in ['', 'konfirmasi-penerimaan-bantuan', 'penjadwalan-penyaluran',
        'monitoring-pendampingan', 'evaluasi-terapi', 'verifikasi-dokumen', 'lainnya'];
    }

    function validServiceStatusDocument(data, ppksId) {
      return data.keys().hasAll(['ppksId', 'nutritionStatus', 'entrepreneurshipStatus',
          'psychosocialStatus', 'lastNutritionAt', 'lastEntrepreneurshipAt', 'lastTherapyAt',
          'therapySessionCount', 'followUpAt', 'followUpReason', 'assignedToUid',
          'createdAt', 'updatedAt', 'updatedByUid'])
        && data.keys().hasOnly(['ppksId', 'nutritionStatus', 'entrepreneurshipStatus',
          'psychosocialStatus', 'lastNutritionAt', 'lastEntrepreneurshipAt', 'lastTherapyAt',
          'therapySessionCount', 'followUpAt', 'followUpReason', 'assignedToUid',
          'createdAt', 'updatedAt', 'updatedByUid'])
        && data.ppksId == ppksId
        && data.ppksId is string && data.ppksId.size() > 0 && data.ppksId.size() <= 150
        && validAssistanceStatus(data.nutritionStatus)
        && validAssistanceStatus(data.entrepreneurshipStatus)
        && validTherapyStatus(data.psychosocialStatus)
        && validServiceDate(data.lastNutritionAt)
        && validServiceDate(data.lastEntrepreneurshipAt)
        && validServiceDate(data.lastTherapyAt)
        && data.therapySessionCount is int
        && data.therapySessionCount >= 0 && data.therapySessionCount <= 5000
        && validServiceDate(data.followUpAt)
        && validFollowUpReason(data.followUpReason)
        && ((data.followUpAt == '' && data.followUpReason == '')
          || (data.followUpAt != '' && data.followUpReason != ''))
        && data.assignedToUid is string && data.assignedToUid.size() <= 128
        && (canWritePpks() || data.assignedToUid == request.auth.uid)
        && data.createdAt is timestamp
        && data.updatedAt == request.time
        && data.updatedByUid == request.auth.uid;
    }

    match /ppksServiceStatus/{ppksId} {
      allow read: if canWritePpks()
        || (hasRole('pendamping') && resource.data.assignedToUid == request.auth.uid);
      allow create: if canWritePpks()
        && validServiceStatusDocument(request.resource.data, ppksId)
        && request.resource.data.therapySessionCount <= 1;
      allow update: if isStaff()
        && validServiceStatusDocument(request.resource.data, ppksId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.therapySessionCount >= resource.data.therapySessionCount
        && request.resource.data.therapySessionCount <= resource.data.therapySessionCount + 1
        && (canWritePpks() || resource.data.assignedToUid == request.auth.uid);
      allow delete: if false;
    }

    match /ppksServiceEvents/{eventId} {
      allow read: if canWritePpks()
        || (hasRole('pendamping') && resource.data.assignedToUid == request.auth.uid);
      allow create: if isStaff()
        && request.resource.data.keys().hasAll(['id', 'ppksId', 'eventType', 'status',
          'serviceDate', 'followUpAt', 'followUpReason', 'createdByUid', 'assignedToUid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['id', 'ppksId', 'eventType', 'status',
          'serviceDate', 'followUpAt', 'followUpReason', 'createdByUid', 'assignedToUid', 'createdAt'])
        && request.resource.data.id == eventId
        && request.resource.data.ppksId is string
        && request.resource.data.ppksId.size() > 0 && request.resource.data.ppksId.size() <= 150
        && ((request.resource.data.eventType in ['nutrition-assistance', 'entrepreneurship-assistance']
              && validAssistanceStatus(request.resource.data.status))
          || (request.resource.data.eventType == 'psychosocial-therapy'
              && validTherapyStatus(request.resource.data.status)))
        && validServiceDate(request.resource.data.serviceDate)
        && validServiceDate(request.resource.data.followUpAt)
        && validFollowUpReason(request.resource.data.followUpReason)
        && ((request.resource.data.followUpAt == '' && request.resource.data.followUpReason == '')
          || (request.resource.data.followUpAt != '' && request.resource.data.followUpReason != ''))
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.assignedToUid is string
        && request.resource.data.assignedToUid.size() <= 128
        && (canWritePpks() || request.resource.data.assignedToUid == request.auth.uid)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    // Deny all collections unless a collection-specific policy is added.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
