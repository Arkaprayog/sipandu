+test('SIPANDU only reads from the Google Forms API (justifies the read-only Forms scope)', () => {
+  const source = readFileSync('src/lib/googleWorkspace.ts', 'utf8');
+  const calls = [...source.matchAll(/forms\.googleapis\.com\/v1\/forms[^`'"]*[`'"]([^;]*?)\);/gs)];
+  assert.ok(calls.length >= 3, 'expected the known Forms API calls');
+  for (const call of calls) {
+    assert.ok(!/method:\s*'(POST|PUT|PATCH|DELETE)'/.test(call[1]), `Forms write call found: ${call[0].slice(0, 120)}`);
