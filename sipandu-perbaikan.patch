diff --git a/scripts/generate-headers.mjs b/scripts/generate-headers.mjs
new file mode 100644
index 0000000..0dc03ca
--- /dev/null
+++ b/scripts/generate-headers.mjs
@@ -0,0 +1,116 @@
+// Generates dist/_headers (Cloudflare Workers Static Assets) after `vite build`.
+//
+// The Content-Security-Policy needs SHA-256 hashes of the inline <script> blocks and inline
+// event-handler attributes in dist/index.html (the boot-error / stale-asset recovery code), so
+// the file is generated from the real build output instead of being hand-maintained.
+//
+// Rollout policy:
+//   - Content-Security-Policy        : low-risk directives only (framing, <base>, <object>, forms).
+//   - Content-Security-Policy-Report-Only : the full script/connect/frame policy. Watch the
+//     browser console for violations, then promote it to enforcing (see docs/SECURITY-HEADERS.md).
+//
+// Note: GitHub Pages ignores `_headers`; these headers apply to the Cloudflare Worker only.
+import crypto from 'node:crypto';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const FIREBASE_AUTH_DOMAIN_HOSTS = [
+  'https://gen-lang-client-0197631978.firebaseapp.com',
+  'https://gen-lang-client-0197631978.web.app',
+];
+const REGISTRATION_WORKER = 'https://sipandu-registration.aryprayoga139.workers.dev';
+
+/** Cloudflare limits every line of a _headers file to 2,000 characters. */
+export const MAX_HEADERS_LINE_LENGTH = 2000;
+
+const sha256 = (value) => `'sha256-${crypto.createHash('sha256').update(value, 'utf8').digest('base64')}'`;
+
+const decodeAttribute = (value) => value
+  .replace(/&quot;/g, '"')
+  .replace(/&#39;|&apos;/g, "'")
+  .replace(/&lt;/g, '<')
+  .replace(/&gt;/g, '>')
+  .replace(/&amp;/g, '&');
+
+export function collectInlineHashes(html) {
+  const scripts = [];
+  for (const match of html.matchAll(/<script\b(?![^>]*\bsrc\s*=)[^>]*>([\s\S]*?)<\/script>/gi)) {
+    if (match[1].trim()) scripts.push(sha256(match[1]));
+  }
+  const handlers = [];
+  for (const match of html.matchAll(/\son[a-z]+\s*=\s*"([^"]*)"/gi)) {
+    handlers.push(sha256(decodeAttribute(match[1])));
+  }
+  return { scripts: [...new Set(scripts)], handlers: [...new Set(handlers)] };
+}
+
+export function buildPolicies(html) {
+  const { scripts, handlers } = collectInlineHashes(html);
+  const alwaysOn = [
+    "frame-ancestors 'none'",
+    "base-uri 'self'",
+    "object-src 'none'",
+    "form-action 'self'",
+  ];
+  const full = [
+    "default-src 'self'",
+    ["script-src 'self'", ...scripts,
+      'https://apis.google.com', 'https://www.google.com/recaptcha/', 'https://www.gstatic.com/recaptcha/'].join(' '),
+    ["script-src-attr", handlers.length ? "'unsafe-hashes'" : "'none'", ...handlers].join(' '),
+    "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
+    "font-src 'self' data: https://fonts.gstatic.com",
+    // Respondent/Drive photos arrive as https URLs, data: URLs or blob: URLs.
+    "img-src 'self' data: blob: https:",
+    "media-src 'self' blob: data:",
+    ["connect-src 'self'", 'https://*.googleapis.com', 'https://*.firebaseio.com', 'wss://*.firebaseio.com',
+      'https://www.google.com', 'https://accounts.google.com', REGISTRATION_WORKER].join(' '),
+    ['frame-src', 'https://accounts.google.com', 'https://www.google.com/recaptcha/', 'https://recaptcha.google.com',
+      ...FIREBASE_AUTH_DOMAIN_HOSTS].join(' '),
+    "worker-src 'self' blob:",
+    "manifest-src 'self'",
+    ...alwaysOn,
+  ];
+  return { enforced: alwaysOn.join('; '), reportOnly: full.join('; ') };
+}
+
+export function buildHeadersFile(html) {
+  const { enforced, reportOnly } = buildPolicies(html);
+  const lines = [
+    '# Generated by scripts/generate-headers.mjs — do not edit by hand.',
+    '/*',
+    '  X-Content-Type-Options: nosniff',
+    '  X-Frame-Options: DENY',
+    '  Referrer-Policy: strict-origin-when-cross-origin',
+    '  Strict-Transport-Security: max-age=31536000',
+    // allow-popups keeps Firebase/Google sign-in popups working (same-origin would break them).
+    '  Cross-Origin-Opener-Policy: same-origin-allow-popups',
+    '  Permissions-Policy: camera=(self), geolocation=(self), microphone=(), payment=(), usb=(), serial=(), bluetooth=()',
+    `  Content-Security-Policy: ${enforced}`,
+    `  Content-Security-Policy-Report-Only: ${reportOnly}`,
+    '',
+    // Vite emits content-hashed file names under /assets, so they can be cached forever.
+    '/assets/*',
+    '  Cache-Control: public, max-age=31536000, immutable',
+    '',
+  ];
+  for (const line of lines) {
+    if (line.length > MAX_HEADERS_LINE_LENGTH) {
+      throw new Error(`_headers line exceeds ${MAX_HEADERS_LINE_LENGTH} characters (${line.length}): ${line.slice(0, 60)}…`);
+    }
+  }
+  return lines.join('\n');
+}
+
+const isMain = process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url);
+if (isMain) {
+  const dist = path.resolve('dist');
+  const indexPath = path.join(dist, 'index.html');
+  if (!fs.existsSync(indexPath)) {
+    console.error('generate-headers: dist/index.html tidak ditemukan. Jalankan `vite build` terlebih dahulu.');
+    process.exit(1);
+  }
+  const output = buildHeadersFile(fs.readFileSync(indexPath, 'utf8'));
+  fs.writeFileSync(path.join(dist, '_headers'), output, 'utf8');
+  console.log(`dist/_headers ditulis (${output.length} byte).`);
+}
diff --git a/scripts/generate-headers.test.mjs b/scripts/generate-headers.test.mjs
new file mode 100644
index 0000000..a8660c2
--- /dev/null
+++ b/scripts/generate-headers.test.mjs
@@ -0,0 +1,46 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import crypto from 'node:crypto';
+import { MAX_HEADERS_LINE_LENGTH, buildHeadersFile, buildPolicies, collectInlineHashes } from './generate-headers.mjs';
+
+const sha = (value) => `'sha256-${crypto.createHash('sha256').update(value, 'utf8').digest('base64')}'`;
+const HTML = `<!doctype html><html><head>
+<link rel="stylesheet" href="x.css" media="print" onload="this.media='all'">
+<script type="module" crossorigin src="./assets/index-abc.js"></script>
+</head><body>
+<button onclick="doIt(&quot;a&quot;)">x</button>
+<script>
+  window.__boot = 1;
+</script>
+</body></html>`;
+
+test('inline scripts and event-handler attributes are hashed; external scripts are not', () => {
+  const { scripts, handlers } = collectInlineHashes(HTML);
+  assert.deepEqual(scripts, [sha('\n  window.__boot = 1;\n')]);
+  assert.deepEqual(handlers.sort(), [sha("this.media='all'"), sha('doIt("a")')].sort());
+});
+
+test('enforced CSP only carries directives that cannot break the app; full policy is report-only', () => {
+  const { enforced, reportOnly } = buildPolicies(HTML);
+  assert.match(enforced, /frame-ancestors 'none'/);
+  assert.ok(!/script-src|connect-src/.test(enforced));
+  assert.match(reportOnly, /script-src 'self' 'sha256-/);
+  assert.ok(!/script-src[^;]*'unsafe-inline'/.test(reportOnly), 'scripts must never allow unsafe-inline');
+  assert.ok(!/script-src[^;]*'unsafe-eval'/.test(reportOnly));
+  assert.match(reportOnly, /object-src 'none'/);
+});
+
+test('generated _headers has every required security header and respects the 2,000-character line limit', () => {
+  const file = buildHeadersFile(HTML);
+  for (const header of [
+    'X-Content-Type-Options: nosniff',
+    'X-Frame-Options: DENY',
+    'Referrer-Policy:',
+    'Strict-Transport-Security:',
+    'Cross-Origin-Opener-Policy: same-origin-allow-popups',
+    'Permissions-Policy:',
+    'Content-Security-Policy:',
+    'Content-Security-Policy-Report-Only:',
+  ]) assert.ok(file.includes(header), header);
+  assert.ok(file.split('\n').every((line) => line.length <= MAX_HEADERS_LINE_LENGTH));
+});
