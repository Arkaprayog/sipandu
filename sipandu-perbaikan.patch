 }
+
+
+/**
+ * Saves an already generated PDF on the user's device. Browsers/PWA download the file with
+ * its A4 PDF name; inside the Android/iOS WebView (where blob downloads are not supported)
+ * the system print sheet is opened, which offers "Save as PDF" and printing.
+ */
+export async function savePdfToDevice(blob: Blob, fileName: string): Promise<'downloaded' | 'system-dialog'> {
+  if (blob.size <= 0) throw new Error('File PDF kosong dan tidak dapat disimpan.');
+  if (Capacitor.isNativePlatform()) {
+    await printPdfBlob(blob, fileName);
+    return 'system-dialog';
+  }
+  const objectUrl = URL.createObjectURL(new Blob([blob], { type: 'application/pdf' }));
+  try {
+    const link = document.createElement('a');
+    link.href = objectUrl;
+    link.download = fileName.toLowerCase().endsWith('.pdf') ? fileName : fileName + '.pdf';
+    link.rel = 'noopener';
+    document.body.appendChild(link);
+    link.click();
+    link.remove();
+  } finally {
+    window.setTimeout(() => URL.revokeObjectURL(objectUrl), 120_000);
+  }
+  return 'downloaded';
+}
