--- /dev/null
+++ b/src/lib/assessmentPdfAssembly.test.ts
@@ -0,0 +1,62 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { PDFDocument } from 'pdf-lib';
+import { A4_HEIGHT_PT, A4_WIDTH_PT, PAGE_MARGIN_PT, fitImageToA4 } from './a4Layout';
+import { buildDriveUploadMetadata } from './googleDriveMultipart';
+
+// 16x23 px baseline JPEG, generated once so the test needs no image library.
+const TINY_JPEG_BASE64 = '';
+
+test('A4 constants match ISO 216 (210 x 297 mm)', () => {
+  assert.ok(Math.abs(A4_WIDTH_PT - (210 / 25.4) * 72) < 0.1);
+  assert.ok(Math.abs(A4_HEIGHT_PT - (297 / 25.4) * 72) < 0.1);
+});
+
+test('rendered sheets are fitted inside the A4 margins without distortion', () => {
+  // The app renders a 194 x 281 mm sheet.
+  const placement = fitImageToA4(194, 281);
+  assert.ok(placement.x >= PAGE_MARGIN_PT - 0.01);
+  assert.ok(placement.x + placement.width <= A4_WIDTH_PT - PAGE_MARGIN_PT + 0.01);
+  assert.ok(placement.y >= PAGE_MARGIN_PT - 0.01);
+  assert.ok(placement.y + placement.height <= A4_HEIGHT_PT - PAGE_MARGIN_PT + 0.01);
+  assert.ok(Math.abs(placement.width / placement.height - 194 / 281) < 1e-9);
+  // Very tall and very wide inputs still fit (no page-size dependency on the content).
+  for (const [w, h] of [[10, 5000], [5000, 10], [1833, 2655]] as const) {
+    const p = fitImageToA4(w, h);
+    assert.ok(p.width <= A4_WIDTH_PT && p.height <= A4_HEIGHT_PT);
+  }
+  assert.throws(() => fitImageToA4(0, 10));
+});
+
+test('a 12-page assessment becomes a real A4 PDF, with no size cap on the output', async () => {
+  const jpeg = Buffer.from(TINY_JPEG_BASE64, 'base64');
+  const pdf = await PDFDocument.create();
+  const image = await pdf.embedJpg(jpeg);
+  for (let index = 0; index < 12; index += 1) {
+    const page = pdf.addPage([A4_WIDTH_PT, A4_HEIGHT_PT]);
+    page.drawImage(image, fitImageToA4(image.width, image.height));
+  }
+  const bytes = await pdf.save({ useObjectStreams: true });
+  assert.equal(Buffer.from(bytes.slice(0, 5)).toString('latin1'), '%PDF-');
+
+  const reopened = await PDFDocument.load(bytes);
+  assert.equal(reopened.getPageCount(), 12);
+  for (const page of reopened.getPages()) {
+    const { width, height } = page.getSize();
