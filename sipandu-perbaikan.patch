+/**
+ * Confirms that Drive stored the archive as a PDF. If a replaced legacy file kept its old
+ * application/json type, correct it explicitly; fail loudly rather than report success for
+ * a file that Drive would show (and download) as JSON.
+ */
+async function ensureDriveFileIsPdf(fileId: string, fileName: string): Promise<void> {
+  const fields = '?fields=id,name,mimeType&supportsAllDrives=true';
+  const read = async () => {
+    const response = await driveFetch('/files/' + encodeURIComponent(fileId) + fields);
+    if (!response.ok) throw new Error('Tipe file arsip Google Drive tidak dapat diperiksa (HTTP ' + response.status + ').');
+    return await response.json() as { mimeType?: string; name?: string };
+  };
+  let file = await read();
+  if (file.mimeType === 'application/pdf' && /\.pdf$/i.test(file.name || '')) return;
+
+  const fixed = await driveFetch('/files/' + encodeURIComponent(fileId) + fields, {
+    method: 'PATCH',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ name: fileName, mimeType: 'application/pdf' }),
+  });
+  if (!fixed.ok) {
+    throw new Error('Arsip Google Drive tersimpan sebagai ' + (file.mimeType || 'tipe tidak dikenal') + ' dan tidak dapat dikoreksi menjadi PDF (HTTP ' + fixed.status + ').');
+  }
+  file = await read();
+  if (file.mimeType !== 'application/pdf') {
+    throw new Error('Arsip Google Drive tetap bertipe ' + (file.mimeType || 'tidak dikenal') + ', bukan PDF.');
+  }
+}
