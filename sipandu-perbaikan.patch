--- /dev/null
+++ b/src/lib/localCache.ts
@@ -0,0 +1,122 @@
+import type { PPKSRecord } from '../types';
+
+/**
+ * Browser-side cache policy for personal data.
+ *
+ * - Inline photos (data: URLs of face / KTP / KK / house) are never written to
+ *   localStorage. The canonical copy lives in Firestore / Google Drive and is
+ *   re-hydrated from there after sign-in.
+ * - The PPKS roster cache is scoped to one Firebase UID.
+ * - Everything that can hold personal data is removed on sign-out.
+ */
+
+export const LEGACY_PPKS_CACHE_KEY = 'sipandu_ppks';
+export const PPKS_CACHE_KEY_PREFIX = 'sipandu_ppks_v2:';
+
+/** Key prefixes (matched with startsWith) that are wiped on sign-out. */
+const SENSITIVE_KEY_PREFIXES = [
+  'sipandu_ppks',                           // legacy + per-UID roster cache
+  'sipandu_profile',                        // staff profile cache (name, NIP, phone, photo)
+  'sipandu_respondent_notifications_v1',    // notification history (respondent names)
+];
+
+const PHOTO_FIELDS = ['fotoDiri', 'fotoKtp', 'fotoKk', 'fotoRumah'] as const;
+
+export type CacheStorage = Pick<Storage, 'getItem' | 'setItem' | 'removeItem' | 'key' | 'length'>;
+
+export function isInlineImageData(value: unknown): boolean {
+  return typeof value === 'string' && /^\s*data:/i.test(value);
+}
+
+function stripPhotoMap(map: unknown): { value: unknown; changed: boolean } {
+  if (!map || typeof map !== 'object' || Array.isArray(map)) return { value: map, changed: false };
+  let changed = false;
+  const next: Record<string, unknown> = {};
+  for (const [key, entry] of Object.entries(map as Record<string, unknown>)) {
+    if (isInlineImageData(entry)) {
+      changed = true;
+      continue;
+    }
+    next[key] = entry;
+  }
+  return { value: changed ? next : map, changed };
+}
+
+/** Returns the record without inline image data. Links (https / Drive) are kept. */
+export function stripInlinePhotoData<T extends Partial<PPKSRecord>>(record: T): T {
+  if (!record || typeof record !== 'object') return record;
+  let result: Record<string, unknown> | null = null;
+  const ensure = () => (result ??= { ...(record as Record<string, unknown>) });
+
+  for (const field of PHOTO_FIELDS) {
+    if (isInlineImageData((record as Record<string, unknown>)[field])) ensure()[field] = '';
+  }
+  const overrides = stripPhotoMap((record as Record<string, unknown>).manualPhotoOverrides);
+  if (overrides.changed) ensure().manualPhotoOverrides = overrides.value;
+
+  return (result ?? record) as T;
+}
+
+export function stripInlinePhotoDataFromList<T extends Partial<PPKSRecord>>(records: T[]): T[] {
+  return records.map((record) => stripInlinePhotoData(record));
+}
+
+/** Staff profile cache: the profile photo may be a large data: URL. */
+export function sanitizeProfileForCache<T extends { photoUrl?: unknown }>(profile: T): T {
+  if (profile && isInlineImageData(profile.photoUrl)) return { ...profile, photoUrl: '' };
+  return profile;
+}
+
+export function ppksCacheKey(uid: string): string {
+  return `${PPKS_CACHE_KEY_PREFIX}${uid || 'anonymous'}`;
+}
+
+/**
+ * Reads the roster cache for this UID. A cache written by an older app version
+ * (single global key) is migrated once — with photos removed — and then deleted.
+ */
+export function readPpksCache(storage: CacheStorage, uid: string): unknown {
+  const key = ppksCacheKey(uid);
+  const current = storage.getItem(key);
+  if (current) return JSON.parse(current);
+
+  const legacy = storage.getItem(LEGACY_PPKS_CACHE_KEY);
+  if (!legacy) return null;
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(legacy);
+  } finally {
+    storage.removeItem(LEGACY_PPKS_CACHE_KEY);
+  }
+  if (!Array.isArray(parsed)) return parsed;
+  const sanitized = stripInlinePhotoDataFromList(parsed as Partial<PPKSRecord>[]);
+  try { storage.setItem(key, JSON.stringify(sanitized)); } catch { /* quota: cache is optional */ }
+  return sanitized;
+}
+
+export function writePpksCache(storage: CacheStorage, uid: string, records: PPKSRecord[]): void {
+  storage.setItem(ppksCacheKey(uid), JSON.stringify(stripInlinePhotoDataFromList(records)));
+  // Never leave a pre-upgrade global copy (with photos) behind.
+  storage.removeItem(LEGACY_PPKS_CACHE_KEY);
+}
+
+/** Removes every cached roster, profile and notification history. Safe to call repeatedly. */
+export function clearSensitiveLocalCache(storage: CacheStorage): number {
+  const doomed: string[] = [];
+  for (let index = 0; index < storage.length; index += 1) {
+    const key = storage.key(index);
+    if (key && SENSITIVE_KEY_PREFIXES.some((prefix) => key.startsWith(prefix))) doomed.push(key);
+  }
+  for (const key of doomed) {
+    try { storage.removeItem(key); } catch { /* continue wiping the remaining keys */ }
+  }
+  return doomed.length;
+}
+
+export function safeLocalStorage(): CacheStorage | null {
+  try {
+    return typeof window !== 'undefined' && window.localStorage ? window.localStorage : null;
+  } catch {
+    return null;
+  }
+}
