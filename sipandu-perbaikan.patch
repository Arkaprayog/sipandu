+import test from 'node:test';
+import assert from 'node:assert/strict';
+import type { PPKSRecord } from '../types';
+import {
+  LEGACY_PPKS_CACHE_KEY,
+  clearSensitiveLocalCache,
+  ppksCacheKey,
+  readPpksCache,
+  sanitizeProfileForCache,
+  stripInlinePhotoData,
+  writePpksCache,
+  type CacheStorage,
+} from './localCache';
+
+class MemoryStorage implements CacheStorage {
+  private readonly map = new Map<string, string>();
+  get length() { return this.map.size; }
+  key(index: number) { return [...this.map.keys()][index] ?? null; }
+  getItem(key: string) { return this.map.has(key) ? this.map.get(key)! : null; }
+  setItem(key: string, value: string) { this.map.set(key, String(value)); }
+  removeItem(key: string) { this.map.delete(key); }
+  keys() { return [...this.map.keys()]; }
+}
+
+const DATA_URL = 'data:image/jpeg;base64,/9j/4AAQSkZJRgABAQ';
+
+function record(overrides: Partial<PPKSRecord> = {}): PPKSRecord {
+  return {
+    id: 'p1', timestamp: '2026-11-01', namaLengkap: 'Contoh Nama', nik: '1234567890123456', usia: 30,
+    jenisKelamin: 'Laki-laki', kotaDomisili: 'Medan', alamatLengkap: 'Jl. Contoh', noHpWa: '0812345678',
+    jenisBantuan: '-', intervensiMental: '-', desil: 1,
+    fotoDiri: DATA_URL, fotoKtp: 'https://drive.google.com/file/d/abc/view', statusAsesmen: 'Tahap Awal',
+    ...overrides,
+  } as PPKSRecord;
+}
+
+test('inline photo data is removed but Drive/HTTPS links are kept', () => {
+  const stripped = stripInlinePhotoData(record({
+    fotoKk: DATA_URL,
+    manualPhotoOverrides: { fotoDiri: DATA_URL, fotoKtp: 'https://example.org/ktp.jpg' },
+  }));
+  assert.equal(stripped.fotoDiri, '');
+  assert.equal(stripped.fotoKk, '');
+  assert.equal(stripped.fotoKtp, 'https://drive.google.com/file/d/abc/view');
+  assert.deepEqual(stripped.manualPhotoOverrides, { fotoKtp: 'https://example.org/ktp.jpg' });
+  assert.equal(stripped.nik, '1234567890123456');
+});
+
+test('records without inline photos are returned unchanged (same reference)', () => {
+  const clean = record({ fotoDiri: 'https://example.org/a.jpg' });
+  assert.equal(stripInlinePhotoData(clean), clean);
+});
+
+test('written cache never contains a data: URL and is scoped to the UID', () => {
+  const storage = new MemoryStorage();
+  writePpksCache(storage, 'uid-A', [record()]);
+  const raw = storage.getItem(ppksCacheKey('uid-A'))!;
+  assert.ok(!raw.includes('data:image'));
+  assert.equal(storage.getItem(ppksCacheKey('uid-B')), null);
+  assert.equal(readPpksCache(storage, 'uid-B'), null);
+});
+
+test('legacy global cache is migrated once, photo-free, and deleted', () => {
+  const storage = new MemoryStorage();
+  storage.setItem(LEGACY_PPKS_CACHE_KEY, JSON.stringify([record()]));
+  const migrated = readPpksCache(storage, 'uid-A') as PPKSRecord[];
+  assert.equal(migrated[0].fotoDiri, '');
+  assert.equal(storage.getItem(LEGACY_PPKS_CACHE_KEY), null);
+  assert.ok(storage.getItem(ppksCacheKey('uid-A')));
+  assert.ok(!storage.getItem(ppksCacheKey('uid-A'))!.includes('data:image'));
+});
+
+test('sign-out wipe removes roster, profile and notification history but keeps device settings', () => {
+  const storage = new MemoryStorage();
+  writePpksCache(storage, 'uid-A', [record()]);
+  storage.setItem(LEGACY_PPKS_CACHE_KEY, '[]');
+  storage.setItem('sipandu_profile', '{}');
+  storage.setItem('sipandu_profile_uid-A', '{}');
+  storage.setItem('sipandu_respondent_notifications_v1:uid-A', '[]');
+  storage.setItem('sipandu_settings', '{}');
+  storage.setItem('sipandu_app_pin_hash_v1', 'x');
+  storage.setItem('sipandu_respondent_notification_baseline_v1:uid-A', '{}');
+
+  const removed = clearSensitiveLocalCache(storage);
+  assert.equal(removed, 5);
+  assert.deepEqual(storage.keys().sort(), [
+    'sipandu_app_pin_hash_v1',
+    'sipandu_respondent_notification_baseline_v1:uid-A',
+    'sipandu_settings',
+  ]);
+  assert.equal(clearSensitiveLocalCache(storage), 0);
+});
+
+test('profile photo data URL is not cached', () => {
+  assert.equal(sanitizeProfileForCache({ nama: 'A', photoUrl: DATA_URL }).photoUrl, '');
+  const withLink = { nama: 'A', photoUrl: 'https://example.org/p.png' };
+  assert.equal(sanitizeProfileForCache(withLink), withLink);
+});
