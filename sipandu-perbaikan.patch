+/** ISO 216 A4 in PDF points (1 pt = 1/72 inch). */
+export const A4_WIDTH_PT = 595.276;
+export const A4_HEIGHT_PT = 841.89;
+export const PAGE_MARGIN_PT = (8 / 25.4) * 72;
+
+export interface A4Placement {
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+}
+
+/** Fits a rendered page image inside the printable area of an A4 page (top aligned, centered). */
+export function fitImageToA4(imageWidth: number, imageHeight: number): A4Placement {
+  if (!(imageWidth > 0) || !(imageHeight > 0)) {
+    throw new Error('Ukuran gambar halaman tidak valid untuk PDF A4.');
+  }
+  const contentWidth = A4_WIDTH_PT - PAGE_MARGIN_PT * 2;
+  const contentHeight = A4_HEIGHT_PT - PAGE_MARGIN_PT * 2;
+  const fit = Math.min(contentWidth / imageWidth, contentHeight / imageHeight);
+  const width = imageWidth * fit;
+  const height = imageHeight * fit;
+  return {
+    x: (A4_WIDTH_PT - width) / 2,
+    y: A4_HEIGHT_PT - PAGE_MARGIN_PT - height,
+    width,
+    height,
+  };
+}
