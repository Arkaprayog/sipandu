@@ -0,0 +1,28 @@
+/**
+ * Google OAuth scopes requested for the SIPANDU central Workspace account.
+ *
+ * Why each scope is needed (verified against src/lib/googleWorkspace.ts and
+ * src/lib/googleDriveBackup.ts):
+ *  - drive:          reads respondent photo files uploaded through Google Forms (files
+ *                    SIPANDU did not create), moves them into SIPANDU folders, and removes
+ *                    demo/obsolete files. `drive.file` alone cannot do this.
+ *  - spreadsheets:   reads the response sheet and writes the dedicated "SIPANDU" tab.
+ *  - forms.body.readonly / forms.responses.readonly:
+ *                    SIPANDU only ever GETs forms and responses. Write access to the form
+ *                    structure (`forms.body`) is intentionally NOT requested.
+ *
+ * `drive.file` is not listed because it is a strict subset of `drive`.
+ */
+export const GOOGLE_IDENTITY_SCOPES = ['email', 'profile'] as const;
+
+export const GOOGLE_WORKSPACE_API_SCOPES = [
+  'https://www.googleapis.com/auth/drive',
+  'https://www.googleapis.com/auth/spreadsheets',
+  'https://www.googleapis.com/auth/forms.body.readonly',
+  'https://www.googleapis.com/auth/forms.responses.readonly',
+] as const;
+
+export const GOOGLE_SIGN_IN_SCOPES: readonly string[] = [
+  ...GOOGLE_IDENTITY_SCOPES,
+  ...GOOGLE_WORKSPACE_API_SCOPES,
+];
