+
+/**
+ * Drive file metadata for a SIPANDU upload. `mimeType` is always sent explicitly: when an
+ * existing file (e.g. a legacy JSON archive) is replaced in place, Drive does not reliably
+ * change its type from the uploaded media alone, which left PDFs labelled application/json.
+ */
+export function buildDriveUploadMetadata(input: {
+  name: string;
+  mimeType: string;
+  folderId: string;
+  existingFileId?: string;
+}): string {
+  if (!input.name || /[\r\n]/.test(input.name)) throw new Error('Nama file Google Drive tidak valid.');
+  if (!input.mimeType || /[\r\n]/.test(input.mimeType)) throw new Error('Tipe file Google Drive tidak valid.');
+  return JSON.stringify({
+    name: input.name,
+    mimeType: input.mimeType,
+    // files.update cannot move a file; keep the existing parent during in-place replacement.
+    ...(!input.existingFileId ? { parents: [input.folderId] } : {}),
+    appProperties: { sipanduManaged: 'true', sipanduArchive: input.folderId },
+  });
+}
