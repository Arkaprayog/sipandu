+  assert.ok(!GOOGLE_SIGN_IN_SCOPES.includes('https://www.googleapis.com/auth/forms.body'));
+  assert.ok(GOOGLE_WORKSPACE_API_SCOPES.includes('https://www.googleapis.com/auth/forms.body.readonly'));
+  assert.ok(GOOGLE_SIGN_IN_SCOPES.includes('email') && GOOGLE_SIGN_IN_SCOPES.includes('profile'));
